# Placeholder names only. Copy to .env.local (and Netlify env vars) and fill in real values. Never commit real keys.
GROQ_API_KEY=your-groq-api-key
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=generate-a-long-random-string
# Local dev URL. On Netlify leave unset; the site URL is used automatically.
BETTER_AUTH_URL=http://localhost:8888
# Optional: override the Groq model used by generate.ts (default qwen/qwen3.8-27b)
GROQ_MODEL=
# Optional: total drafts or recordings all users together may make per 24 hours (default 600 each)
GLOBAL_DAILY_LIMIT=

# Optional tuning for the voice assistant
# GROQ_ASSISTANT_MODEL=openai/gpt-oss-20b
# GROQ_TTS_VOICE=hannah
# ASSISTANT_DAILY_LIMIT=40

# Who sees the subscriptions preview: "all", "off", or a comma separated list of account emails
# FEATURE_SUBSCRIPTIONS=you@example.com

# PayFast subscriptions. Without these the public sandbox test merchant is used and no real money moves.
# PAYFAST_MODE=sandbox            (set to "live" only when real payments are approved)
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
# Confirmation emails after a payment (Resend, free tier)
# RESEND_API_KEY=
# MAIL_FROM=Apex Voice <onboarding@resend.dev>

# 32 random bytes, base64. Losing this key makes encrypted data unreadable, so keep a copy in a password manager.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# DATA_ENCRYPTION_KEY=

# Sign-up is closed by default. Set to true only while a new person needs an account, then remove it.
# ALLOW_SIGNUP=true

# Accounts whose activity (what they say, drafts, errors) is recorded for the owner, comma separated. They are told in the app.
# Read it with: node --env-file=.env.local scripts/activity-report.ts <email>
# ACTIVITY_LOG_EMAILS=tester@example.com
# Optional: logging switches itself off after this day (YYYY-MM-DD)
# ACTIVITY_LOG_UNTIL=2026-11-30
